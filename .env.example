APP_NAME="Sistema Administrativo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Motores soportados y probados: sqlite, mysql/mariadb, pgsql.
# sqlite no necesita servidor: sirve para probar el sistema en 2 minutos.
DB_CONNECTION=sqlite

# MySQL / MariaDB
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=crud_erp
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL (es lo que usa el deploy de Render)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=crud_erp
# DB_USERNAME=crud_erp
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# En un servidor cuyo disco se borra en cada deploy (Render, Fly, Heroku, o
# cualquier contenedor sin volumen), "local" pierde los adjuntos, los PDFs
# generados y los backups. Ahí va "s3" con las credenciales de más abajo: sirve
# cualquier almacenamiento compatible (AWS S3, Cloudflare R2, Backblaze B2,
# MinIO).
# Proxies en los que se confía para leer X-Forwarded-For y X-Forwarded-Proto.
# "*" es lo correcto detrás de un PaaS (Render, Fly, Heroku), donde la IP del
# balanceador cambia. En un VPS con nginx propio conviene acotarlo a la red
# real, por ejemplo TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8: la IP que llega acá es
# con la que se cuentan los intentos de login.
TRUSTED_PROXIES=*

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Carga los datos de demostración la primera vez que arranca el contenedor,
# sólo si la base está vacía (Docker/Render). Dejar en false en una instalación
# real de un cliente.
DB_SEED_ON_BOOT=false

# Rehace los datos de demostración en CADA arranque, borrando lo que haya.
# Sirve para que una demo pública se limpie sola. Nunca activarlo con datos reales.
DB_SEED_ALWAYS=false
