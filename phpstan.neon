includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes

    # Nivel 5: encuentra tipos mal pasados, métodos y propiedades inexistentes y
    # nulls sin comprobar, sin exigir anotaciones genéricas en todo el código.
    level: 5

    # MongoDB no tiene esquema que leer (antes Larastan lo sacaba de las migraciones):
    # los campos de cada documento se declaran con @property en el modelo.
