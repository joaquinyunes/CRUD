includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - database
        - routes

    # Nivel 5: encuentra tipos mal pasados, métodos y propiedades inexistentes y
    # nulls sin comprobar, sin exigir anotaciones genéricas en todo el código.
    level: 5

    # Con esto Larastan conoce las columnas reales de cada tabla y deja de
    # inventar que un modelo no tiene created_at.
    databaseMigrationsPath:
        - database/migrations
